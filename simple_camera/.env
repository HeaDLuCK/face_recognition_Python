MONGO_URL=mongodb://localhost:27017
MONGO_DB_NAME=ai_camera_service
AUTO_START_SAVED_CAMERAS=true
OPENCV_NUM_THREADS=1

INSIGHTFACE_MODEL_NAME=buffalo_s
INSIGHTFACE_PROVIDERS=CPUExecutionProvider
INSIGHTFACE_CTX_ID=-1
INSIGHTFACE_DET_SIZE=640
CAMERA_FRAME_SKIP=3
DEFAULT_RECOGNITION_THRESHOLD=0.50

RECOGNITION_CANDIDATE_WINDOW_SECONDS=1
RECOGNITION_CANDIDATE_MIN_HITS=3
RECOGNITION_CANDIDATE_FAST_MARGIN=0.03
RECOGNITION_CANDIDATE_FLOOR_MARGIN=0.05
RECOGNITION_IDENTITY_HOLD_SECONDS=1.2

ERP_SYNC_INTERVAL_SECONDS=30
ERP_ASSIGNMENT_INTERVAL_SECONDS=10
ERP_SYNC_BATCH_SIZE=10