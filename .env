ENVIRONMENT=development
ERP_BASE_URL=
# CAMERA_SOURCE_MODE=usb
# USB_CAMERA_INDEX=0
# DEV_TENANT_ID=DEV_COMPANY
# DEV_CAMERA_ID=USB_CAM_01


MONGO_URL=mongodb://localhost:27017
MONGO_DB_NAME=ai_camera_service
AUTO_START_SAVED_CAMERAS=true
OPENCV_NUM_THREADS=1

INSIGHTFACE_MODEL_NAME=buffalo_s
INSIGHTFACE_PROVIDERS=CPUExecutionProvider
INSIGHTFACE_CTX_ID=-1
INSIGHTFACE_DET_SIZE=640
FACE_DETECTION_MIN_SCORE=0.55
DEFAULT_RECOGNITION_THRESHOLD=0.50

STREAM_FPS=15
STREAM_JPEG_QUALITY=80
RTSP_DROP_STALE_FRAMES=0
RTSP_LOW_LATENCY=false
RTSP_READ_RETRIES=5
RTSP_RECONNECT_DELAY_SECONDS=0.5
EVENT_BUFFER_ENABLED=false
SHOW_DEV_FPS=false
CAMERA_FRAME_SKIP=1
RECOGNITION_DROP_OLD_FRAMES=true
FACE_CANDIDATE_BUFFER_SIZE=4
FACE_CANDIDATE_WINDOW_SECONDS=0.5
RECOGNITION_CANDIDATE_WINDOW_SECONDS=1.0
RECOGNITION_CANDIDATE_MIN_HITS=2
RECOGNITION_CANDIDATE_SCORE_MARGIN=0.25
RECOGNITION_CANDIDATE_FAST_MARGIN=0.05
RECOGNITION_INTERVAL_SECONDS=0.5
SHOW_DEV_DETECTIONS=false
DRAW_FACE_BOXES_ON_SNAPSHOTS=true
DRAW_FACE_LABELS_ON_SNAPSHOTS=true

PLATE_YOLO_MODEL_PATH=app/plates/model/moroccan_plate.pt
PLATE_YOLO_CONFIDENCE=0.45
PLATE_YOLO_IMGSZ=640
PLATE_YOLO_DEVICE=cpu
PLATE_YOLO_MODE=plate
PLATE_YOLO_CLASS_IS_TEXT=false
PLATE_RECOGNITION_INTERVAL_SECONDS=1.0
PLATE_RECOGNITION_QUEUE_SIZE=2
PLATE_DUPLICATE_COOLDOWN_SECONDS=60
PLATE_SAVE_SNAPSHOTS=true
PLATE_MIN_CHARACTERS=4
PLATE_MAX_DETECTIONS=5

FIRE_YOLO_MODEL_PATH=app/fire/model/fire_model.pt
FIRE_YOLO_CONFIDENCE=0.45
FIRE_YOLO_IMGSZ=640
FIRE_YOLO_DEVICE=cpu
FIRE_DETECTION_INTERVAL_SECONDS=1.0
FIRE_DETECTION_QUEUE_SIZE=2
FIRE_DUPLICATE_COOLDOWN_SECONDS=60
FIRE_SAVE_SNAPSHOTS=true
FIRE_MAX_DETECTIONS=5

EVENT_CLIP_DIR=event_clips
HISTORY_CLIP_DIR=history_clips
EVENT_BUFFER_SECONDS=45
EVENT_CLIP_FPS=20
EVENT_CLIP_COOLDOWN_SECONDS=10
EVENT_MARKER_HISTORY_BEFORE_SECONDS=30
EVENT_MARKER_HISTORY_AFTER_SECONDS=30
MOTION_CHECK_FRAME_SKIP=5
MOTION_PIXEL_THRESHOLD=35
MOTION_AREA_RATIO=0.02
SHOW_MOTION_ZONES=true

UNKNOWN_FACE_MIN_DETECTION_SCORE=0.75
UNKNOWN_FACE_MIN_HEIGHT_PX=40
UNKNOWN_FACE_MIN_BLUR_SCORE=20
UNKNOWN_FACE_SKIP_WEAK_KNOWN_MARGIN=0.20
UNKNOWN_FACE_CROP_SIMILARITY_THRESHOLD=0.45
UNKNOWN_FACE_CACHE_MAX_ENTRIES=1000
UNKNOWN_FACE_CROP_CACHE_MAX_ENTRIES=500
UNKNOWN_FACE_DB_MATCH_LIMIT=500
DETECTION_EVENT_CACHE_MAX_ENTRIES=2000
SNAPSHOT_PURGE_BATCH_SIZE=200

PERSON_TRACKING_ENABLED=true
PERSON_YOLO_MODEL_PATH=app/tracking/model/person_yolo.pt
HISTORY_RECOVERY_ENABLED=true