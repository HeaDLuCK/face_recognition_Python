MONGO_URL=mongodb://localhost:27017
MONGO_DB_NAME=ai_camera_service
AUTO_START_SAVED_CAMERAS=true
OPENCV_NUM_THREADS=1

INSIGHTFACE_MODEL_NAME=buffalo_s
INSIGHTFACE_PROVIDERS=CPUExecutionProvider
INSIGHTFACE_CTX_ID=-1
INSIGHTFACE_DET_SIZE=640

STREAM_FPS=15
RTSP_DROP_STALE_FRAMES=0
RTSP_LOW_LATENCY=false
RTSP_READ_RETRIES=5
RTSP_FAILED_READS_BEFORE_RECONNECT=3
RTSP_FAILED_READ_RETRY_DELAY_SECONDS=0.05
RTSP_RECONNECT_DELAY_SECONDS=0.5
SHOW_DEV_FPS=false
CAMERA_FRAME_SKIP=1
ATTENDANCE_STRICT_FRAME_PROCESSING=true
FACE_CANDIDATE_BUFFER_SIZE=1
FACE_CANDIDATE_WINDOW_SECONDS=0
RECOGNITION_INTERVAL_SECONDS=0

# High-recall attendance mode: inspect every frame that the AI pipeline can
# consume, and keep retrying an unrecognized body until it leaves the view.
PERSON_DETECTION_INTERVAL_SECONDS=0
PERSON_FACE_CANDIDATE_WINDOW_SECONDS=0
PERSON_FACE_ATTEMPT_INTERVAL_SECONDS=0
PERSON_FACE_MAX_ATTEMPTS=0
SHOW_DEV_DETECTIONS=false
EVENT_CLIP_COOLDOWN_SECONDS=10
MOTION_CHECK_FRAME_SKIP=1

UNKNOWN_FACE_MIN_HEIGHT_PX=40
UNKNOWN_FACE_MIN_BLUR_SCORE=20
UNKNOWN_FACE_SKIP_WEAK_KNOWN_MARGIN=0.20

HISTORY_RECOVERY_BEFORE_SECONDS=15
HISTORY_RECOVERY_AFTER_SECONDS=15

PERSON_TRACKING_ENABLED=true
HISTORY_RECOVERY_ENABLED=true
