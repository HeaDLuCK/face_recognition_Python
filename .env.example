APP_NAME="AI Camera Service"
ENVIRONMENT=development
LOG_LEVEL=INFO
OPENCV_NUM_THREADS=1

ERP_BASE_URL=
ERP_API_TOKEN=

MONGO_URL=mongodb://localhost:27017
MONGO_DB_NAME=ai_camera_service

SNAPSHOT_DIR=snapshots

DEFAULT_RECOGNITION_THRESHOLD=0.55
DEFAULT_DUPLICATE_COOLDOWN_SECONDS=60

INSIGHTFACE_MODEL_NAME=buffalo_l
INSIGHTFACE_PROVIDERS=CPUExecutionProvider
INSIGHTFACE_CTX_ID=-1
INSIGHTFACE_DET_SIZE=640
FACE_DETECTION_MIN_SCORE=0.65
UNKNOWN_FACE_CACHE_MAX_ENTRIES=1000
UNKNOWN_FACE_CROP_CACHE_MAX_ENTRIES=500
UNKNOWN_FACE_DB_MATCH_LIMIT=500
DETECTION_EVENT_CACHE_MAX_ENTRIES=2000
SNAPSHOT_PURGE_BATCH_SIZE=200

CAMERA_FRAME_SKIP=1
RECOGNITION_DROP_OLD_FRAMES=true
FACE_CANDIDATE_BUFFER_SIZE=4
FACE_CANDIDATE_WINDOW_SECONDS=0.5
RECOGNITION_CANDIDATE_WINDOW_SECONDS=1.0
RECOGNITION_CANDIDATE_MIN_HITS=2
RECOGNITION_CANDIDATE_SCORE_MARGIN=0.25
RECOGNITION_CANDIDATE_FAST_MARGIN=0.05
RECOGNITION_INTERVAL_SECONDS=0.2
FACE_SCHEDULER_MAX_PENDING_PER_CAMERA=12

# Optional attendance person tracking. Put a COCO-compatible Ultralytics
# person model at PERSON_YOLO_MODEL_PATH before enabling this.
PERSON_TRACKING_ENABLED=false
PERSON_YOLO_MODEL_PATH=app/tracking/model/person_yolo.pt
PERSON_YOLO_CONFIDENCE=0.45
PERSON_YOLO_IMGSZ=640
PERSON_YOLO_DEVICE=cpu
PERSON_YOLO_MAX_DETECTIONS=20
PERSON_DETECTION_INTERVAL_SECONDS=0.2
PERSON_IDLE_PROBE_SECONDS=2.0
PERSON_MOTION_HOLD_SECONDS=2.0
PERSON_MOTION_PIXEL_THRESHOLD=25
PERSON_MOTION_AREA_RATIO=0.01
PERSON_TRACK_IOU_THRESHOLD=0.25
PERSON_TRACK_TIMEOUT_SECONDS=3.0
PERSON_FACE_CANDIDATE_WINDOW_SECONDS=0.4
PERSON_FACE_ATTEMPT_INTERVAL_SECONDS=0.35
PERSON_FACE_MAX_ATTEMPTS=3
PERSON_FACE_MIN_CROP_HEIGHT=80
SHOW_PERSON_TRACKS=true

# Unresolved tracks are retried from Hikvision recording history while live
# face AI is idle.
HISTORY_RECOVERY_ENABLED=true
HISTORY_RECOVERY_BEFORE_SECONDS=2
HISTORY_RECOVERY_AFTER_SECONDS=3
HISTORY_RECOVERY_POLL_SECONDS=10
HISTORY_RECOVERY_INITIAL_DELAY_SECONDS=20
HISTORY_RECOVERY_MAX_ATTEMPTS=3
HISTORY_RECOVERY_MAX_FRAMES=60
HISTORY_RECOVERY_LIVE_IDLE_SECONDS=0.5
HISTORY_RECOVERY_LIVE_IDLE_TIMEOUT_SECONDS=30

# auto: use usb://0 or numeric camera sources as USB, RTSP URLs as IP streams
# usb: force local USB webcam using USB_CAMERA_INDEX
# rtsp: force ERP camera URLs as RTSP/IP streams
CAMERA_SOURCE_MODE=auto
USB_CAMERA_INDEX=0
RTSP_URL=
RTSP_URLS=
RTSP_CHANNELS=
DEV_TENANT_ID=DEV_COMPANY
DEV_CAMERA_ID=USB_CAM_01
STREAM_FPS=20
STREAM_JPEG_QUALITY=80
SHOW_DEV_FPS=true
SHOW_DEV_DETECTIONS=true
DRAW_FACE_BOXES_ON_SNAPSHOTS=true
DRAW_FACE_LABELS_ON_SNAPSHOTS=true

PLATE_YOLO_MODEL_PATH=app/plates/model/moroccan_plate.pt
PLATE_YOLO_CONFIDENCE=0.45
PLATE_YOLO_IMGSZ=640
PLATE_YOLO_DEVICE=cpu
PLATE_YOLO_MODE=plate
PLATE_YOLO_CLASS_IS_TEXT=false
PLATE_RECOGNITION_INTERVAL_SECONDS=1.0
PLATE_RECOGNITION_QUEUE_SIZE=2
PLATE_DUPLICATE_COOLDOWN_SECONDS=60
PLATE_SAVE_SNAPSHOTS=true
PLATE_MIN_CHARACTERS=4
PLATE_MAX_DETECTIONS=5

FIRE_YOLO_MODEL_PATH=app/fire/model/fire_model.pt
FIRE_YOLO_CONFIDENCE=0.45
FIRE_YOLO_IMGSZ=640
FIRE_YOLO_DEVICE=cpu
FIRE_DETECTION_INTERVAL_SECONDS=1.0
FIRE_DETECTION_QUEUE_SIZE=2
FIRE_DUPLICATE_COOLDOWN_SECONDS=60
FIRE_SAVE_SNAPSHOTS=true
FIRE_MAX_DETECTIONS=5

# Optional outbound cloud stream push. Leave empty to disable.
CLOUD_STREAM_WS_URL=
CLOUD_STREAM_TOKEN=
CLOUD_STREAM_FPS=10
CLOUD_STREAM_RECONNECT_SECONDS=5

EVENT_CLIP_DIR=event_clips
EVENT_BUFFER_SECONDS=30
EVENT_CLIP_FPS=15
EVENT_CLIP_COOLDOWN_SECONDS=30
EVENT_MARKER_HISTORY_BEFORE_SECONDS=30
EVENT_MARKER_HISTORY_AFTER_SECONDS=30

# Polygon zones to watch for motion/change.
# Format: zone_id:x,y|x,y|x,y;another_zone:x,y|x,y|x,y|x,y
# Example: MOTION_ZONES=door:100,120|420,120|420,360|100,360
MOTION_ZONES=
MOTION_CHECK_FRAME_SKIP=5
MOTION_PIXEL_THRESHOLD=35
MOTION_AREA_RATIO=0.02
SHOW_MOTION_ZONES=true
